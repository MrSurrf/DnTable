/* ============================================
   ГЛОБАЛЬНЫЕ СТИЛИ Tile Dashboard
   
   Здесь только базовые стили приложения:
   - Главное окно
   - Меню
   - Общие классы кнопок, списков и т.д.
   
   Стили конкретных плагинов - в их папках:
   plugins/{plugin_name}/styles.qss
   ============================================ */

/* ==================== ГЛОБАЛЬНЫЕ ==================== */
QMainWindow {
    background-color: #1a1a1a;
}

QWidget {
    font-family: Segoe UI;
    font-size: 11px;
}

/* ==================== МЕНЮ ==================== */
QMenuBar {
    background-color: #2d2d2d;
    color: #eeeeee;
    padding: 4px;
    font-size: 12px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #444444;
}

QMenuBar::item:pressed {
    background-color: #555555;
}

QMenu {
    background-color: #2d2d2d;
    color: #eeeeee;
    border: 1px solid #444444;
    padding: 4px;
    font-size: 11px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #444444;
}

QMenu::separator {
    height: 1px;
    background-color: #444444;
    margin: 4px 8px;
}

/* ==================== TILE WIDGET (контейнер) ==================== */
/* Это базовые стили для контейнера плагинов */
TileWidget {
    background-color: #2d2d2d;
    border-radius: 12px;
    border: 1px solid #444444;
}

TileWidget:hover {
    border: 1px solid #666666;
}

TileWidget QFrame#header {
    background-color: #3d3d3d;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom: 1px solid #555555;
}

TileWidget QLabel#titleLabel {
    color: #eeeeee;
    font-size: 12px;
    font-weight: bold;
}

TileWidget QLabel#closeBtn {
    font-size: 16px;
    font-weight: bold;
    color: #666666;
    padding: 0 4px;
}

TileWidget QLabel#closeBtn:hover {
    color: #FF6464;
}

/* ==================== БАЗОВЫЕ ЭЛЕМЕНТЫ УПРАВЛЕНИЯ ==================== */

/* Кнопки - базовый стиль */
QPushButton {
    background-color: #3d3d3d;
    color: #eeeeee;
    border: 1px solid #555555;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #4d4d4d;
    border-color: #666666;
}

QPushButton:pressed {
    background-color: #555555;
}

QPushButton:disabled {
    background-color: #2d2d2d;
    color: #555555;
    border-color: #333333;
}

/* Основная кнопка действия (синяя) */
QPushButton#primaryButton {
    background-color: #6496FF;
    color: white;
    border: none;
}

QPushButton#primaryButton:hover {
    background-color: #7aa6ff;
}

QPushButton#primaryButton:pressed {
    background-color: #4d85ff;
}

/* Кнопка успеха (зелёная) */
QPushButton#successButton {
    background-color: #64FF64;
    color: #1a1a1a;
    border: none;
}

QPushButton#successButton:hover {
    background-color: #7aff7a;
}

/* Кнопка опасности (красная) */
QPushButton#dangerButton {
    background-color: #FF6464;
    color: white;
    border: none;
}

QPushButton#dangerButton:hover {
    background-color: #ff7a7a;
}

/* Кнопка навигации (стрелки) */
QPushButton#navButton {
    min-width: 32px;
    min-height: 32px;
    padding: 4px;
    font-size: 14px;
}

/* Выпадающие списки */
QComboBox {
    background-color: #2d2d2d;
    color: #eeeeee;
    border: 1px solid #444444;
    border-radius: 6px;
    padding: 6px 10px;
    min-width: 100px;
}

QComboBox:hover {
    border-color: #555555;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #eeeeee;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #2d2d2d;
    color: #eeeeee;
    border: 1px solid #444444;
    selection-background-color: #6496FF;
    selection-color: white;
    outline: none;
}

/* Списки */
QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
}

QListWidget::item {
    background-color: #2d2d2d;
    border: 1px solid #444444;
    border-radius: 6px;
    padding: 8px;
    margin: 2px 4px;
    min-height: 36px;
}

QListWidget::item:selected {
    background-color: #3d3d3d;
    border: 2px solid #6496FF;
}

QListWidget::item:hover {
    background-color: #353535;
    border-color: #555555;
}

/* Полосы прокрутки */
QScrollBar:vertical {
    background-color: #2d2d2d;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #555555;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #666666;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #2d2d2d;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #555555;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #666666;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Подсказки */
QToolTip {
    background-color: #3d3d3d;
    color: #eeeeee;
    border: 1px solid #555555;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
}
