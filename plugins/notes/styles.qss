/* ============================================
   Стили для плагина "Заметки"
   ============================================ */

/* Заголовок */
PluginWidget QLabel#header {
    font-weight: bold;
    color: #eee;
}

/* Текстовое поле */
PluginWidget QTextEdit#textEdit {
    background-color: #252525;
    border: 1px solid #444;
    border-radius: 6px;
    color: #eee;
    padding: 8px;
    font-family: Segoe UI;
    font-size: 11px;
}

PluginWidget QTextEdit#textEdit:focus {
    border-color: #6496FF;
}

/* Счётчик символов */
PluginWidget QLabel#counter {
    color: #666;
    font-size: 10px;
}

PluginWidget QLabel#counter[almostFull="true"] {
    color: #FF6464;
}
