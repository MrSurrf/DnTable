/* ============================================
   Стили для плагина "Эффекты"
   ============================================ */

/* Виджет предпросмотра */
EffectPreviewWidget {
    background-color: #1a1a1a;
    border: 2px solid #444;
    border-radius: 8px;
}

/* Заголовок */
EffectPreviewWidget QLabel#title_label {
    font-weight: bold;
    color: #eee;
    font-size: 12px;
}

/* Контейнер превью */
EffectPreviewWidget QFrame#preview_container {
    background-color: #252525;
    border-radius: 8px;
    border: 1px dashed #555;
}

/* Область превью */
EffectPreviewWidget QLabel#preview_label {
    font-size: 48px;
    background: transparent;
}

/* Описание */
EffectPreviewWidget QLabel#desc_label {
    color: #888;
    font-size: 10px;
}

/* Кнопка воспроизведения */
EffectPreviewWidget QPushButton#play_btn:enabled {
    background-color: #6496FF;
}

EffectPreviewWidget QPushButton#play_btn:enabled:hover {
    background-color: #7aa6ff;
}

/* Заголовок списка */
PluginWidget QLabel#list_header {
    font-weight: bold;
    color: #6496FF;
    font-size: 11px;
}

/* Заголовок превью */
PluginWidget QLabel#preview_header {
    font-weight: bold;
    color: #6496FF;
    font-size: 11px;
}

/* Кнопки действий */
PluginWidget QPushButton#apply_btn {
    background-color: #64FF64;
    color: #1a1a1a;
    font-weight: bold;
}

PluginWidget QPushButton#apply_btn:hover {
    background-color: #7aff7a;
}

PluginWidget QPushButton#clear_btn {
    background-color: #FF6464;
    color: white;
}
